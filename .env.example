# Docker Compose reads this file after you copy it to .env.
# For a local shell, export variables manually. Django does not load .env files.
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret-before-deploying
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
POSTGRES_PASSWORD=local-development-only
# Local Python defaults to SQLite. Set this when connecting to PostgreSQL yourself.
# DATABASE_URL=postgresql://pressroom:local-development-only@localhost:5432/pressroom
